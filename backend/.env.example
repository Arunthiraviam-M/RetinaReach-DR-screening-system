# =============================================================================
# RetinaScan District DR Screening Platform — Backend Environment Configuration
# Copy this file to `.env` in the same folder and fill in your real values.
# =============================================================================

# ---------- Application ----------
APP_NAME=RetinaScan District Screening API
APP_ENV=development                # development | staging | production
API_V1_PREFIX=/api/v1
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- MongoDB Atlas ----------
# This is YOUR responsibility to fill in — create a free/shared cluster at
# https://www.mongodb.com/cloud/atlas, create a DB user, whitelist your IP
# (or 0.0.0.0/0 for dev), and paste the connection string below.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://marunthiraviam_db_user:UgJUILeZoDj1r0Vj@retinareachcluster.oefuw46.mongodb.net
MONGODB_DB_NAME=retinascan

# ---------- Auth / JWT ----------
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- File / Image Storage ----------
# STORAGE_BACKEND=local for demo (saves to backend/storage). Set to "s3" in
# production and fill the S3 block below.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=retinascan-images
S3_REGION=ap-south-1

# ---------- ML Model Weights ----------
# Point these at real trained weights once you have them. If a path does not
# exist, the service automatically falls back to the deterministic
# image-analysis heuristic grader so the app still runs end-to-end.
DR_CLASSIFIER_WEIGHTS_PATH=../ml_models/weights/dr_classifier.pt
SEGMENTATION_WEIGHTS_PATH=../ml_models/weights/segmentation.pt
OCT_MODEL_WEIGHTS_PATH=../ml_models/weights/oct_model.pt
MODEL_DEVICE=cpu                   # cpu | cuda

# ---------- Rate Limiting ----------
UPLOAD_RATE_LIMIT=20/minute
ANALYZE_RATE_LIMIT=10/minute

# ---------- Data Retention / Compliance ----------
DATA_RETENTION_DAYS=1825           # 5 years, adjust to your program's policy
AUDIT_LOG_ENABLED=true
